# Copy to .env in repo root, then: set -a && source .env && set +a
OPENAI_API_KEY=

# Optional — match cluster CUDA (set before bootstrap.sh)
# TORCH_INDEX_URL=https://download.pytorch.org/whl/cu126
# BOOTSTRAP_FRESH_VENV=1   # rm .venv before bootstrap (handled inside bootstrap.sh)

# Optional — force KernelBench timing JSON (see README Baselines)
# KERNELBENCH_BASELINE_HW=H100_PCIe_LambdaLabs

# Optional
# PYTHON_VERSION=3.12
# DSPY_CACHEDIR=/path/to/.dspy_cache
# LITELLM_LOG=ERROR
